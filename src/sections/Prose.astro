---
import { cls } from '../scripts/core/names';

interface Props {
  reveal?: boolean;
  jelly?: boolean;
}
const { reveal = true, jelly = false } = Astro.props;
---

<section class={cls('prose')} data-jelly={jelly ? '' : undefined}>
  <div class={cls('prose', 'body')} data-reveal={reveal ? '' : undefined}>
    <slot />
  </div>
</section>
