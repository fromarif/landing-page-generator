---
import { cls } from '../scripts/core/names';

interface Props {
  reveal?: boolean;
  jelly?: boolean;
}
const { reveal = true, jelly = false } = Astro.props;
---

<section class={cls('prose')} data-jelly={jelly ? '' : undefined}>
  <div class={cls('prose', 'body')} data-reveal={reveal ? '' : undefined}>
    <slot />
  </div>
</section>

<style lang="scss">
  @use '../styles/prefix' as *;

  .#{$prefix}-prose {
    min-height: 60vh;
    padding: 8rem 1.5rem;
    background: var(--bg);
    color: var(--fg);

    &__body {
      max-width: 40ch;
      font-size: 1.5rem;
      line-height: 1.4;
    }

    &__body :global(p) {
      margin: 0 0 1.5rem;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }
</style>
