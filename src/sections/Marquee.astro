---
import { cls } from '../scripts/core/names';

interface Props {
  items: string[];
  speed?: number;
  reverse?: boolean;
  /** Scroll velocity drives the speed and flips direction. Off = constant. */
  velocity?: boolean;
}
const { items, speed = 10, reverse = false, velocity = true } = Astro.props;
---

<section
  class={cls('marquee')}
  data-marquee
  data-marquee-speed={speed}
  data-marquee-reverse={reverse ? '' : undefined}
  data-marquee-velocity={velocity ? undefined : 'off'}
>
  <div class={cls('marquee', 'track')}>
    {items.map((item) => (
      <span class={cls('marquee', 'item')}>{item}</span>
    ))}
  </div>
</section>
