---
import { cls } from '../scripts/core/names';

interface Props {
  heading: string;
  src?: string;
  tint?: string;
}
const { heading, src = '/video/blob.mp4', tint = '#ff4d00' } = Astro.props;
---

<section class={cls('blob')} data-cursor="-inverse">
  <div class={cls('blob', 'media')} style={`--tint: ${tint}`}>
    <video
      class={cls('blob', 'video')}
      src={src}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <div class={cls('blob', 'tint')}></div>
  </div>

  <h2 class={cls('blob', 'heading')} data-split="lines">{heading}</h2>
</section>
