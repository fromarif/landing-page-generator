---
import { cls } from '../scripts/core/names';

interface Props {
  heading: string;
  label?: string;
  href?: string;
}
const { heading, label = "Let's talk", href = '/about/' } = Astro.props;
const stickId = `${cls('cta')}-${Math.random().toString(36).slice(2, 8)}`;
---

<section class={cls('cta')}>
  <h2 class={cls('cta', 'heading')} data-split>{heading}</h2>

  <div class={cls('cta', 'action')} data-reveal>
    <a
      id={stickId}
      class={cls('cta', 'button')}
      href={href}
      data-magnetic
      data-cursor="-exclusion"
      data-cursor-stick={`#${stickId}`}
    >
      <span class={cls('cta', 'label')}>{label}</span>
    </a>
  </div>
</section>
