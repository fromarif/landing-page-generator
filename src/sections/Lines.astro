---
import { cls } from '../scripts/core/names';

interface Props {
  heading: string;
  /** RGBA 0..1, comma separated. */
  color?: string;
  lines?: number;
  bend?: number;
}
const { heading, color, lines, bend } = Astro.props;
---

<section
  class={cls('lines')}
  data-bglines
  data-bglines-color={color}
  data-bglines-lines={lines}
  data-bglines-bend={bend}
>
  <canvas class={cls('lines', 'canvas')} aria-hidden="true"></canvas>
  <h2 class={cls('lines', 'heading')} data-split="lines">{heading}</h2>
</section>
