---
import { cls } from '../scripts/core/names';

interface Props {
  heading: string;
  count?: number;
  src?: string;
  /** ScrollTrigger syntax: "<section edge> <viewport edge>", e.g. "top center". */
  start?: string;
  end?: string;
  /** Screens of scroll to hold the section at the top. 0 disables pinning. */
  pin?: number;
  /** "loader" makes the intro overlay wait for every frame. Default: lazy. */
  preload?: 'loader' | 'lazy';
}
const {
  heading,
  count = 483,
  src = '/sequence/',
  start,
  end,
  pin,
  preload,
} = Astro.props;
---

<section
  class={cls('sequence')}
  data-sequence
  data-sequence-count={count}
  data-sequence-src={src}
  data-sequence-start={start}
  data-sequence-end={end}
  data-sequence-pin={pin}
  data-sequence-preload={preload}
>
  <canvas class={cls('sequence', 'canvas')} aria-hidden="true"></canvas>
  <h2 class={cls('sequence', 'heading')}>{heading}</h2>
</section>

<style lang="scss">
  @use '../styles/prefix' as *;

  .#{$prefix}-sequence {
    position: relative;
    display: grid;
    place-items: center;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);

    &__canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    &__heading {
      position: relative;
      margin: 0;
      max-width: 16ch;
      text-align: center;
      mix-blend-mode: difference;
      color: #fff;
      font-size: clamp(2rem, 6vw, 5rem);
      line-height: 1;
      letter-spacing: -0.03em;
    }
  }
</style>
