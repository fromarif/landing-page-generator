---
import { cls } from '../scripts/core/names';

interface Props {
  title: string;
  label?: string;
}
const { title, label } = Astro.props;
---

<section class={cls('hero')}>
  {label && <p class={cls('hero', 'label')} data-reveal>{label}</p>}
  <h1 class={cls('hero', 'title')} data-split>{title}</h1>
</section>
