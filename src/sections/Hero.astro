---
import { cls } from '../scripts/core/names';

interface Props {
  title: string;
  label?: string;
}
const { title, label } = Astro.props;
---

<section class={cls('hero')}>
  {label && <p class={cls('hero', 'label')} data-reveal>{label}</p>}
  <h1 class={cls('hero', 'title')} data-split>{title}</h1>
</section>

<style lang="scss">
  @use '../styles/prefix' as *;

  .#{$prefix}-hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem;
    background: var(--bg);
    color: var(--fg);

    &__label {
      margin: 0 0 1rem;
      font-size: 1rem;
      opacity: 0.6;
    }

    &__title {
      margin: 0;
      font-size: clamp(3rem, 12vw, 11rem);
      line-height: 0.95;
      font-weight: 700;
      letter-spacing: -0.03em;
    }
  }
</style>
