---
import { site } from '../config/site';
import { cls } from '../scripts/core/names';
---

<footer class={cls('footer')}>
  <p>© {new Date().getFullYear()} {site.name}</p>
</footer>

<style lang="scss">
  @use '../styles/prefix' as *;
  .#{$prefix}-footer {
    padding: 4rem 1.5rem;
    background: var(--bg);
    color: var(--fg);
    border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);

    p {
      margin: 0;
    }
  }
</style>
