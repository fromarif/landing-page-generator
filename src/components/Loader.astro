---
import { site } from '../config/site';
import { cls } from '../scripts/core/names';
---

<div class={cls('loader')} transition:persist>
  <span class={cls('loader', 'mark')}>{site.name}</span>
  <span class={cls('loader', 'count')} aria-hidden="true"></span>
</div>

<style lang="scss">
  @use '../styles/prefix' as *;
  .#{$prefix}-loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--fg);
    color: var(--bg);
    opacity: 1;
    visibility: visible;

    &__mark {
      font-weight: 700;
      font-size: 1.5rem;
      letter-spacing: -0.02em;
    }

    &__count {
      position: absolute;
      bottom: 1.5rem;
      right: 1.5rem;
      font-size: 1rem;
      font-variant-numeric: tabular-nums;
      opacity: 0.6;

      &:empty {
        display: none;
      }
    }
  }
</style>
